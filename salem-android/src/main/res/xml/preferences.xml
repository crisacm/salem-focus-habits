<!--
  Default values of the preferences, loaded by SharedPreferencesStorage with
  PreferenceManager.setDefaultValues. The Settings screen is written in Compose
  (SettingsContent.kt) and uses the same keys.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreferenceCompat android:defaultValue="false" android:key="pref_short_toggle" />
    <SwitchPreferenceCompat android:defaultValue="false" android:key="pref_midnight_delay" />
    <SwitchPreferenceCompat android:defaultValue="false" android:key="pref_skip_enabled" />
    <SwitchPreferenceCompat android:defaultValue="false" android:key="pref_unknown_enabled" />
    <SwitchPreferenceCompat android:defaultValue="false" android:key="pref_checkmark_reverse_order" />
    <SwitchPreferenceCompat android:defaultValue="false" android:key="pref_pure_black" />
    <SwitchPreferenceCompat android:defaultValue="false" android:key="pref_disable_animation" />
    <ListPreference android:defaultValue="255" android:key="pref_widget_opacity" />
    <SwitchPreferenceCompat android:defaultValue="false" android:key="pref_sticky_notifications" />
    <SwitchPreferenceCompat android:defaultValue="false" android:key="pref_developer" />

</PreferenceScreen>
