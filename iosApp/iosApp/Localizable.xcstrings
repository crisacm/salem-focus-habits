    "measurable_example" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "مثال، كم ميلاً قطعته اليوم؟ كم عدد الصفحات التي قرأتها؟" } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "напр. Колко километра пробягахте днес? Колко страници прочетохте?" } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "p.e. Quants quilòmetres has fet hui? Quantes pàgines has llegit?" } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "např. Kolik kilometrů jsi dnes uběhl? Kolik stránek jsi dnes přečetl?" } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "f.eks Hvor mange kilometer kørte du i dag? Hvor mange sider læste du?" } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "z.B. Wie viele Kilometer bist du heute gelaufen? Wie viele Seiten hast du gelesen?" } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "π.χ. Πόσα χιλιόμετρα τρέξατε σήμερα; Πόσες σελίδες διαβάσατε;" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "e.g. How many miles did you run today? How many pages did you read?" } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "ej. ¿Cuántas millas has corrido hoy? ¿Cuántas páginas has leído?" } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Adib. Zenbat kilometro egin dituzu gaur? Zenbat orrialde irakurri dituzu?" } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "مثلاً امروز چند کیلومتر دویدید؟ چند صفحه مطالعه کردید؟" } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "esim. Montako kilometriä juoksit tänään? Montako sivua luit?" } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Par exemple : Quelle distance avez vous parcouru aujourd'hui ? \nCombien de pages avez-vous lu ?" } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "למשל: כמה קילומטרים רצת היום? כמה עמודים קראת?" } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "जैसे आज आप कितने मील दौड़े? आपने कितने पन्ने पढ़े?" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "npr. Koliko si kilometara danas istrčao/la? Koliko si stranica pročitao/la?" } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "pl. Hány kilométert futottál ma? Hány oldalt olvastál el?" } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "mis. Berapa km kamu berlari hari ini? Berapa lembar yang sudah kamu baca?" } },
        "is-IS" : { "stringUnit" : { "state" : "translated", "value" : "t.d., Hversu marga kílómetra hljópstu í dag? Hvað lasstu margar blaðsíður?" } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "es. Quanti chilometri hai percorso oggi? Quante pagine hai letto?" } },
