        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "자세한 그래프로 시간에 따라 당신의 습관이 어떻게 향상되었는지 보여줍니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "കാലക്രമേണ നിങ്ങളുടെ ശീലങ്ങൾ എങ്ങനെ മെച്ചപ്പെട്ടുവെന്ന് വിശദമായ ഗ്രാഫുകൾ കാണിക്കുന്നു." } },
