    "yes_or_no_example" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "مثلا: هل استيقظت باكرا اليوم؟ هل مارست الرياضة؟ هل لعبت الشطرنج؟" } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "напр. Събудихте ли се рано днес? Тренирахте ли? Играхте ли шах?" } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Per exemple, us heu despertat aviat? Heu fet exercici? Heu jugat a escacs?" } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "např. Vzbudil ses dnes brzy? Cvičil jsi dnes? Hrál jsi šachy?" } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "F.eks. vågnede du tidligt i dag? Har du motioneret? Spillede du skak?" } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "z.B. Bist du heute früh wach geworden? Hast du trainiert? Hast du Schach gespielt?" } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "π.χ. Ξύπνησες νωρίς σήμερα; Ασκήθηκες; Έπαιξες σκάκι;" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "e.g. Did you wake up early today? Did you exercise? Did you play chess?" } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "ej. ¿Te levantaste temprano hoy? ¿Hiciste ejercicio? ¿Jugaste al ajedrez?" } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "adib. Gaur goiz esnatu zara? Ariketa fisikoa egin al duzu? Xakean jolastu al duzu?" } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "آیا امروز زود بیدار شدید؟ ورزش کردید؟ شطرنج بازی کردید؟" } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Esim. heräsitkö tänään aikaisin? Kuntoilitko? Pelasitko sakkia?" } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Par exemple, vous êtes-vous réveillé tôt aujourd'hui ? Avez-vous fait de l'exercice ? Avez-vous joué aux échecs ? " } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "למשל: התעוררת מוקדם היום? עשית כושר? שיחקת שחמט?" } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "उदा। क्या आप आज जल्दी उठ गए? क्या आपने व्यायाम किया? क्या आपने शतरंज खेला?" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "npr. Jesi li se danas rano probudio/la? Jesi li vježbao/la? Jesi li igrao/la šah?" } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "pl. Korán keltél ma fel? Edzettél? Sakkoztál?" } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "mis. Apakah kamu bangun awal hari ini? Apakah kamu sudah berolahraga? Apakah kamu sudah bermain catur?" } },
        "is-IS" : { "stringUnit" : { "state" : "translated", "value" : "t.d., Vaknaðir þú snemma í dag? Æfðir þú þig? Tefldir þú skák?" } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "ad es. Ti sei svegliato presto oggi? Hai fatto esercizio? Hai giocato a scacchi?" } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "例：今日は早く起きましたか？運動しましたか？チェスをしましたか？" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "მაგ. დღეს ადრე გაიღვიძე? ივარჯიშე? ჭადრაკი ითამაშე?" } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "예) 오늘 일찍 일어났나요? 운동 하셨나요? 체스를 하셨나요?" } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "ഉദാ.  ഇന്ന് നേരത്തെ ഉണർന്നോ?  നിങ്ങൾ വ്യായാമം ചെയ്തോ?  നിങ്ങൾ ചെസ്സ് കളിച്ചോ?" } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "bijv. Ben je vandaag vroeg wakker geworden? Heb je gesport? Heb je geschaakt?" } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "np. Czy obudziłeś się dzisiaj wcześnie? Czy ćwiczyłeś? Czy grałeś w szachy?" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ex.: Você acordou cedo hoje? Você se exercitou? Você jogou xadrez?" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "ex. Acordou cedo hoje? Fez exercício? Jogou xadrez?" } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "ex. Te-ai trezit mai devreme astăzi? Ai făcut exerciții? Ai jucat șah?" } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Например, вы рано проснулись сегодня? Вы занимались спортом? Вы играли в шахматы?" } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "napr. Zobudili ste sa dnes skoro? Cvičili ste? Hrali ste šach?" } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "npr. Ste se danes zgodaj zbudili? Ste telovadili? Ste igrali šah?" } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "npr. Da li ste danas rano ustali? Da li ste vežbali? Jeste li igrali šah?" } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "нпр. Да ли сте данас рано устали? Да ли сте вежбали? Јесте ли играли шах?" } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "t.ex. Vaknade du tidigt idag? Tränade du? Spelade du schack?" } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "உதாரணமாக: இன்று நீங்கள் வழக்கம்போல முன் எழுந்தீர்களா? நீங்கள் உடற்பயிற்சி செய்தீர்களா? நீங்கள் சதுரங்கம் விளையாடினீர்களா?" } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "örn: Bugün erken kalktın mı? Egzersiz yaptın mı? Satranç oynadın mı?" } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "напр., чи прокинулися сьогодні зрання? Чи виконали вправи? Або грали в шахи?" } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Ví dụ: Hôm nay bạn có dậy sớm không? Bạn có tập thể dục? Bạn có chơi cờ vua không?" } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "例如：你今天早起了吗？你锻炼了吗？你下棋了吗？" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "例如： 你今天有早起嗎？你有運動嗎？你有下棋嗎？" } }
      }
    },
