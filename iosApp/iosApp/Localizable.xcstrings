    "sticky_notifications_description" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "منع الإشعارات من تمريرها بعيداً. " } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Предотвратява изчистването на известията с плъзване настрани." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Evita les notificacions de ser pispat lluny." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Zabraňuje odstranění upozornění přejetím. " } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Forhindrer notifikationer i at blive swipet væk." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Verhindert das Wegwischen von Benachrichtigungen." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Αποτρέπει την απομάκρυνση των ειδοποιήσεων." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Prevents notifications from being swiped away." } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Malhelpas, ke sciigoj estu forglititaj." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Evita que las notificaciones sean descartadas." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Jakinarazpenak keinu batez ezabatzea sahiesten du." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "از رد کردن اعلان با کشیدن جلوگیری می‌کند." } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Estää ilmoitusten pois pyyhkäisemisen." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Évite que les notifications ne soient enlevées." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "למניעת התעלמות מתזכורות." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "नोटिफिकेशन को स्वाइप करने से रोकता है!" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Spriječava da se obavijesti zanemare." } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Megakadályozza az értesítések eltávolítását" } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Mencegah notifikasi untuk terhapus." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Impedisce di poter rimuovere le notifiche." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "通知をスワイプして消せないようにする" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "ხელს უშლის შეტყობინებების თითის გასმით წაშლას." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "알림을 스와이프해서 제거하는 것을 방지합니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "അറിയിപ്പുകൾ സ്വൈപ്പ് ചെയ്യുന്നതിൽ നിന്ന് തടയുന്നു." } },
        "nb-NO" : { "stringUnit" : { "state" : "translated", "value" : "Forhindrer varslinger fra å bli sveipet vekk." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Voorkom dat meldingen weggehaald kunnen worden." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Zapobiega usunięciu powiadomień." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Impede que as notificações sejam removidas." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Impede que as notificações sejam removidas." } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Împiedică eliminarea notificărilor." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Предотвращает смахивание уведомлений." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Zabráni odstráneniu notifikácií odsunutím." } },
