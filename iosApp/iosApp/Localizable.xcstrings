    "intro_description_4" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "رسوم بيانية مفصلة تُريك كيف تحسنت عاداتك مع مرور الوقت.  " } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Подробни диаграми ви показват как вашите навици са се подобрили с времето." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Els gràfics detallats et mostren com han mirollat els teus hàbits al llarg del temps" } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Detailní grafy ukazují zlepšení vašich návyků v průběhu času." } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Detaljerede grafer viser dig hvordan dine vaner udvikler sig over tid." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Detaillierte Diagramme zeigen dir an, wie sich deine Gewohnheiten entwickelt haben." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Λεπτομερή διαγράμματα σας δείχνουν την πρόοδο των συνηθειών σας." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Detailed graphs show you how your habits improved over time." } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Detalaj grafikaĵoj montras al vi kiel viaj kutimoj pliboniĝis kun la tempo." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Gráficos detallados te muestran cómo mejoraron tus hábitos con el tiempo." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Grafiko zehatzen bitartez denboran zehar zure ohiturak nola hobetu diren ikus ditzakezu" } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "نمودار جزئیات به شما نشان می‌دهد که چطور عادت‌هایتان با گذشت زمان بهبود پیدا کرده‌اند." } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Yksityiskohtaiset kaaviot näyttävät, kuinka rutiinisi ovat kehittyneet ajan kuluessa." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Des graphiques détaillés vous montrent comment vos habitudes évoluent au fil du temps." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "גרפים מפורטים מציגים את השתפרות ההרגלים לאורך זמן." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "\"\nविस्तृत रेखांकन आपको बताएंगे कि कैसे अपनी आदतों में समय के साथ सुधार करें\"" } },
