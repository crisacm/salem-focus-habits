    "customize_notification_summary" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "Change sound, vibration, light and other notification settings" } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Промяна на звук, вибрация, светлина и други настройки на известията" } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Canviar so, vibració, llum i altres ajustaments de notificacions" } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Změnit zvuk, vibrace, světlo a další nastavení upozornění" } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Skift lyd-, vibrations-, lys- og andre notifikationsindstillinger" } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Töne, Vibrationen, Licht und weitere Einstellungen ändern" } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Αλλαγή ρυθμίσεων ήχου, δόνησης, φωτισμού και άλλων ειδοποιήσεων" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Change sound, vibration, light and other notification settings" } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Ŝanĝu sonon, vibron, lumon kaj aliajn sciigajn agordojn" } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Cambiar sonido, vibración, luz y otros ajustes de notificación" } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Aldatu soinua, bibrazioa, argia eta bestelako jakinarazpen-ezarpen" } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "صدا، لرزش، نور و سایر تنظیمات را تغییر دهید" } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Muuta ilmoitusten ääntä, värinää, valoa ja muita asetuksia" } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Modifier le son, les vibrations, la lumière et d'autres paramètres de notification" } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "שינוי הצליל, הרטט, התאורה והגדרות התראה אחרות" } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "ध्वनि, कंपन, प्रकाश और अन्य अधिसूचना सेटिंग्स बदलें" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Postavi zvuk, vibraciju, svjetlo i druge postavke obavijesti" } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Hang, rezgés, fény és egyéb értesítések beállítása" } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Ubah suara, getaran, cahaya, dan pengaturan notifikasi lainnya" } },
        "is-IS" : { "stringUnit" : { "state" : "translated", "value" : "Breyta hljóði, titringi, ljósi og öðrum tilkynningastillingum" } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Cambia suono, vibrazione, luce e altre impostazioni di notifica" } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "音、バイブレーション、通知ランプ、その他の通知設定を変更する" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "ხმის, ვიბრაციის, სინათლისა და შეტყობინებების სხვა პარამეტრების შეცვლა." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "소리, 진동, 밝기 및 기타 알림 설정" } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "ശബ്ദം, വൈബ്രേഷൻ, വെളിച്ചം, മറ്റ് അറിയിപ്പ് ക്രമീകരണങ്ങൾ എന്നിവ മാറ്റുക" } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Wijzig geluid, trilling, licht en andere instellingen voor meldingen" } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Zmień dźwięk, wibrację, światło i inne ustawienia powiadomień" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Alterar som, vibração, luz e outras configurações de notificação" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Alterar som, vibração, luz e outras configurações de notificação" } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Schimbați setările de sunet, vibrații, lumină și altele pentru notificări" } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Настройка параметров уведомлений: звук, вибрация, свет и др." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Zmeňte nastavenie zvuku, vibrácií, svetla a ďalších nastavení upozornení" } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Spremenite nastavitve zvoka, vibriranja, svetlobe in drugih obvestil" } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Menjajte zvuk, vibraciju, svetlo i druge postavke obaveštavanja" } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Мењајте звук, вибрацију, светло и друге поставке обавештавања" } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Ändra ljud, vibration, ljus och andra aviseringsinställningar" } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "சத்தம், அதிர்வு, ஒளி மற்றும் அறிவிப்பு அமைப்புகளை மாற்றவும்" } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Ses, titreşim, ışık ve diğer bildirim ayarlarını değiştir" } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Змінити звук, вібрацію, світло та інші налаштунки сповіщень" } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Thay đổi âm thanh, độ rung, ánh sáng và các cài đặt thông báo khác" } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "更改声音、振动、指示灯（呼吸灯）和其他通知设置" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "變更音效、震動、燈光和其他通知設定" } }
      }
    },
