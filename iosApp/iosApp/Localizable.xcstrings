        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Παράγει ένα αρχείο το οποίο περιέχει όλα τα δεδομένα σας. Είναι δυνατή η επανεισαγωγή του αρχείου." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Generates a file that contains all your data. This file can be imported back." } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Generas dosieron, kiu enhavas ĉiujn viajn datumojn. Ĉi tiu dosiero povas esti importita reen." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Genera un archivo que contiene todos tus datos. Este archivo puede volver a importarse de vuelta." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Zure datu guztiak dituen fitxategi bat sortzen du. Fitxategi hau ezin da berriz inportatu." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "پرونده‌ای تولید می‌کند که شامل تمام اطلاعات شما است. این پرونده قابل بازیابی توسط این برنامه می‌باشد." } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Luo tiedoston jossa on kaikki tietosi. Tämä tiedosto voidaan tuoda takaisin." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Génère un fichier contenant toutes vos données. Ce fichier peut être réimporté." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "ליצירת קובץ שמכיל את כל הנתונים שלך. לא ניתן לייבא את הקובץ בחזרה." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "ऐसी फाइल्स उत्पन्न करता है जिसमे आपका सारा डेटा रहता है इस फ़ाइल को वापस आयात किया जा सकता है।" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Generira datoteku koja sadrži sve vaše podatke. Ova datoteka se može uvoziti." } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Olyan fájlt generál, amely tartalmazza minden adatodat. Ezt a fájlt vissza lehet importálni." } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Menghasilkan file yang berisi seluruh datamu. File ini bisa diimpor kembali." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Genera un file contenente tutti i tuoi dati. Potrà essere importato successivamente." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "すべてのデータが含まれるファイルを生成します。このファイルはインポートして戻すことができます。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "ქმნის ფაილს, რომელიც შენს ყველა მონაცემებს შეიცავს. ამ ფაილის უკან დაიმპორტირება შეუძლებელია." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "모든 데이터를 포함한 파일을 생성합니다. 이 파일은 다시 가져올 수 있습니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "നിങ്ങളുടെ എല്ലാ ഡാറ്റയും അടങ്ങുന്ന ഒരു ഫയൽ സൃഷ്ടിക്കുന്നു.  ഈ ഫയൽ തിരികെ ഇറക്കുമതി ചെയ്യാൻ കഴിയും." } },
        "nb-NO" : { "stringUnit" : { "state" : "translated", "value" : "Genererer en fil som inneholder all dataen din. Denne filen kan ikke importeres tilbake." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Genereert een bestand met al uw gegevens. Dit bestand kan ook terug geïmporteerd worden." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Generuje plik, który zawiera wszystkie Twoje dane. Taki plik może być importowany." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Gera um arquivo que contém todos os dados. Este arquivo pode ser importado de volta." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Gera um ficheiro que contém todos os dados dos seus hábitos. Este ficheiro pode ser novamente importado para a app." } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Generează un fișier ce conține toate datele tale. Acest fișier poate fi importat înapoi." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Генерирует файл, который содержит все ваши данные. Этот файл можно импортировать обратно." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Vytvorí súbor, ktorý obsahuje všetky vaše údaje. Tento súbor je možné importovať späť." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Ustvari datoteko, ki vsebuje vse podatke. To datoteko lahko nato uvozite nazaj." } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Pravi fajl sa svim podacima. Može se kasnije uvoziti." } },
