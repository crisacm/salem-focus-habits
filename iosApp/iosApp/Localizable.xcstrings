        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "ദിവസങ്ങൾ ഒഴിവാക്കുന്നത് പ്രവർത്തനക്ഷമമാക്കുക" } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Overgeslagen dagen inschakelen" } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Włącz pomijanie dni" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Habilitar dias de folga" } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Activați omiterea de zile" } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Включить пропуск дней" } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Povoliť preskočenie dní" } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Omogoči preskok dni" } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Omogući preskakanje dana" } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Омогући прескакање дана" } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Aktivera överhoppning av dagar" } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "தவிர்க்கக்கூடிய நாட்களைச் செயலாக்கவும்" } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Gün atlama özelliğini etkinleştir" } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Увімкнути пропускання днів" } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Bật bỏ qua ngày" } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "启用跳过天数功能" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "啟用跳過天數功能" } }
      }
    },
    "pref_skip_description" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "بدّل مرتين لإضافة تخطي بدلاً من علامة اختيار. التخطيات تحافظ على درجاتك دون تغيير أو خسارة سلسلة الانتصارات." } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Маркирайте два пъти за да добавите пропускане вместо отметка. Пропусканията поддържат силата на навика ви непроменена и не прекъсват поредицата ви." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Toca dues vegades per a afegir una omissió en compte d'una marca de verificació. Les omissions mantenen la teua puntuació sense canvis i no trenquen la ratxa." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Klikněte dvakrát pro přeskočení namísto zaškrtnutí. Pomlčka nezmění vaše skóre, ani nepřeruší vaši sérii. " } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Skift to gange for at tilføje et overspring i stedet for et flueben. Spring over holder din score uændret og bryder ikke din række." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Zwei mal markieren, um eine Lücke einzutragen statt abzuhaken. Lücken lassen deine Wertung unverändert und beenden deine Serie nicht." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Εναλλαγή δύο φορές για να προσθέσετε μια παράκαμψη αντί για ένα σημάδι ελέγχου. Οι παραλείψεις κρατούν το σκορ σας αμετάβλητο και να δε σπάνε το σερί σας." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Toggle twice to add a skip instead of a checkmark. Skips keep your score unchanged and don't break your streak." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Presionar dos veces para agregar un salto en lugar de una marca de verificación. Los saltos mantienen tu puntaje sin cambios y no rompen tu racha." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Sakatu bi aldiz kontrol-markaren ordez atseden bat gehitzeko. Atsedenek zure puntuazioa aldatu gabe mantentzen dute eta ez dute segida hausten." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "دو بار تپ کنید تا به جای تیک زدن، از آن روز بپرید. پریدن از یک روز، امتیاز شما را دست‌نخورده نگه‌می‌دارد و استمرار عادت را خراب نمی‌کند." } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Valitse kahdesti lisätäksesi ohituksen valinnan sijaan. Ohitukset pitävät pisteesi muuttumattomana eivätkä riko suoritusputkeasi." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Appuyer deux fois pour passer un jour au lieu de valider. Passer des jours ne change pas votre score et ne brise pas votre série." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "סימון כפול כדי לדלג במקום לסמן. הדילוג שומר על הציון שלך ללא שינוי ואינו שובר את הרצף שלך." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "चेकमार्क के बजाय स्किप जोड़ने के लिए दो बार टॉगल करें। स्किप आपके स्कोर को जारी रखते हैं और आपकी स्ट्रीक को नहीं तोड़ते हैं।" } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Váltás kétszer, ha kihagyást szeretne hozzáadni a pipa helyett. A kihagyások változatlanul tartják a pontszámot, és nem szakítják meg a sorozatot." } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Alihkan dua kali untuk menambahkan sebuah skip, bukannya tanda centang. Skip membuat skormu tidak berubah dan tidak merusak rentetanmu." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Attiva/disattiva due volte per aggiungere un salto invece di una spunta. Un salto mantiene il tuo punteggio invariato e non interrompe il tuo punteggio." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "2回切り替えることで、チェックマークの代わりにスキップを追加できます。スキップはスコアに影響を与えず、連続記録を継続させたままにできます。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "ორჯერ გადართე, რათა გამოტოვება ჩაამატო თოლიის (✓) მაგივრად. გამოტოვებების მეშვეობით შეფასება უცვლელი დარჩება, ხოლო სერია შენარჩუნდება." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "두번 토글하면, 확인 표시 대신에 해당 일자의 기록을 제외합니다. 제외된 날은 점수에 반영되지 않고, 연속 기록도 유지됩니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "ഒരു ചെക്ക്മാർക്കിന് പകരം ഒരു ഒഴിവാക്കൽ ചേർക്കാൻ രണ്ടുതവണ ടോഗിൾ ചെയ്യുക.  സ്കിപ്പുകൾ നിങ്ങളുടെ സ്കോർ മാറ്റമില്ലാതെ നിലനിർത്തുകയും നിങ്ങളുടെ സ്ട്രീക്ക് തകർക്കുകയുമില്ല" } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Schakel tweemaal om een overgeslagen dag toe te voegen in plaats van een vinkje. Overgeslagen dagen houden je score ongewijzigd en verbreken je streak niet." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Przełącz dwukrotnie, aby dodać pominięcie zamiast znacznika wyboru. Pomijanie utrzymuje niezmieniony wynik i nie przerywa passy." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Clique duas vezes para adicionar um dia de folga. Esses dias mantêm a estabilidade do hábito inalterada e não quebram a corrente." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Переключите дважды, чтобы добавить пропуск вместо галочки. Пропуски сохраняют ваш результат неизменным и не прерывают серию." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Dvojitým prepnutím pridáte namiesto začiarknutia preskočenie. Preskočenia udržia vaše skóre nezmenené a neprerušia vašu sériu." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Dvakrat preklopite, da dodate preskok namesto kljukice. Preskoki ohranjajo vaš rezultat nespremenjen in ne prekinejo vašega niza." } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Dvaput promenite da biste preskočili umesto otkačinjanja. Preskakanje zadržava rezultat nepromenjenim i ne prekida niz." } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Двапут промените да бисте прескочили уместо откачињања. Прескакање задржава резултат непромењеним и не прекида низ." } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Växla två gånger för att hoppa över istället för att bocka för. Att hoppa över behåller dina poäng oförändrade och bryter inte din serie." } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "இரண்டு முறை தொடல், 'தவிர்' வசதியைச் சேர்க்கும். இது உங்கள் மதிப்பெண்ணை மாற்றாது மற்றும் உங்கள் தொடர்ச்சியைக் பாதிக்காது." } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Gün atlamak için ikinci kez işaretleme yapın. Atlanmış günler puanınızı etkilemez ve serinizi bozmaz." } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Перемкніть двічі, щоб додати пропуск замість галочки. Пропуски зберігають ваш результат незмінним і не переривають серію." } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Bật/tắt hai lần để thêm một lần bỏ qua thay vì dấu kiểm. Bỏ qua giữ cho số điểm của bạn không thay đổi và không phá vỡ chuỗi của bạn." } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "切换两次以添加跳过而不是复选标记。跳过将保持您的得分不变，且不会打破你的连续纪录" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "切換兩次、設定跳過，以取代完成標記。跳過功能將維持你的分數不變，不打破你的連續紀錄。" } }
      }
    },
    "pref_unknown_title" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "إظهار علامات الاستفهام للبيانات المفقودة" } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Показване на питанки при липсващи данни" } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Mostra signes d'interrogació per a les dades que falten" } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Zobrazit otazník pro chybějící data" } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Vis spørgsmålstegn for manglende data" } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Fragezeichen für fehlende Daten anzeigen" } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Εμφάνιση ερωτηματικών για τα δεδομένα που λείπουν" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Show question marks for missing data" } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Mostrar signos de interrogación para datos faltantes" } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Adierazi galdera ikurra falta diren datuetan" } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "نمایش علامت سوال برای مواردی که دیتایی وجود ندارد" } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Näytä kysymysmerkki puuttuvan tiedon kohdalla" } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Afficher des points d'interrogations pour les données manquantes" } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "הצגת סימני שאלה לנתונים חסרים" } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "खोयी जानकारी के लिए प्रश्न चिह्न दिखाएं" } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Kérdőjelek megjelenítése a hiányzó adatoknál" } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Tampilkan tanda tanya untuk data yang hilang" } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Mostra punti interrogativi per i dati mancanti" } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "入力のない日に？マークを表示する" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "კითხვის ნიშნის ჩვენება მონაცემთა არარსებობის შემთხვევაში" } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "기록이 없는 날에 물음표 표시" } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "നഷ്ടപ്പെട്ട ഡാറ്റയ്ക്കുള്ള ചോദ്യചിഹ്നങ്ങൾ കാണിക്കുക" } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Vraagtekens weergeven wanneer gegevens ontbreken" } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Pokaż znaki zapytania dla brakujących danych" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mostrar interrogação para dados ausentes" } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Arată semnele de întrebare pentru datele lipsă" } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Показывать вопросительные знаки при отсутствии данных" } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Zobraziť otázniky pre chýbajúce údaje" } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Pokaži vprašaj za manjkajoče podatke" } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Prikaz upitnika gde nema podataka" } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Приказ упитника где нема података" } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Visa frågetecken för data som saknas" } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "பதிவிடாத நாட்களுக்குக் கேள்விக்குறியை காமி" } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Eksik verileri soru işaretiyle göster" } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Показувати знаки питання для відсутніх даних" } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Hiện dấu hỏi cho dữ liệu bị thiếu" } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "对丢失的数据显示问号" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "在資料缺漏處顯示問號" } }
      }
    },
    "pref_unknown_description" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "التفريق بين الأيام التي لا تحتوي على بيانات من الهفوات الفعلية. للدخول في اللقطات المتتابعة ، قم بالتبديل مرتين." } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Разграничаване на дните без данни от реални пропуски. За да добавите пропуск, маркирайте два пъти." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Diferenciar els dies sense dades dels lapses reals. Per introduir un lapse, canvia dues vegades." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Odlište dny bez údajů od nesplněného návyku. Pro zadání \"nesplněno\", klikněte dvakrát. " } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Differentiér dage uden data fra faktiske udeladelser. For at indtaste en udeladelse, skiftes to gange." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Tage ohne Daten von tatsächlichen Lücken unterscheiden. Um eine Lücke einzutragen zweimal markieren." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Διαφορικές ημέρες χωρίς δεδομένα από πραγματικές παραλήψεις. Για να εισάγετε μια παράληψη, κάντε εναλλαγή δύο φορές." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Differentiate days without data from actual lapses. To enter a lapse, toggle twice." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Diferenciar los días sin datos de los lapsos reales. Para ingresar un lapso, presionar dos veces." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Bereizi daturik gabeko egunak benetako hutsegiteetatik. Hutsegite bat sartzeko, sakatu bi aldiz." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "روزهایی که دیتا ندارند و آن‌هایی که از رویشان پریده‌اید را متفاوت نشان می‌دهد. برای پریدن از روی یک روز، دو بار روی آن تپ کنید." } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Erota päivät ilman tietoja todellisista väliin jäämisistä. Lisätäksesi väliin jäämisen, valitse kahdesti." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Différentié les jours sans donnée des jours sans avoir fait les habitudes. Pour passer un jour, appuyez deux fois longtemps au lieu d'une seul fois." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "הפרדת הימים ללא הנתונים מהלולאות בפועל. כדי להיכנס ללולאה, יש לסמן פעמיים." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "वास्तविक चूकों और बिना जानकारीवाले दिनों में अंतर करें। चूक दर्ज करने के लिए, दो बार टॉगल करें।" } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Az adatok nélküli napok megkülönböztetése a tényleges kihagyásoktól. Kihagyás megadásához váltson kétszer." } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Membedakan hari tanpa data dari selang waktu yang aktual. Untuk memasukkan selang waktu, alihkan dua kali." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Differenzia i giorni senza dati dagli intervalli effettivi. Per inserire un intervallo, attiva due volte." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "データが未入力である日と実行しなかった日とを区別します。実行しなかったことを記録するには、2回切り替えます。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "უმონაცემო დღეებისა და გაცდენების განსხვავებულად განხილვა. გაცდენის შესატანად ორჯერ გადართე." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "데이터가 없는 날과 넘겼다고 실제로 기록한 날에 차이를 둡니다. 넘겼다고 기록하려면 두 번 누르세요. " } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "യഥാർത്ഥ വീഴ്ചകളിൽ നിന്ന് ഡാറ്റ ഇല്ലാതെ ദിവസങ്ങൾ വേർതിരിക്കുക.  ഒരു ലാപ്‌സ് നൽകുന്നതിന്, രണ്ടുതവണ ടോഗിൾ ചെയ്യുക." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Onderscheid dagen zonder gegevens van daadwerkelijke verlopen dagen. Klik twee keer om een verlopen dag in te voeren." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Odróżnij dni bez danych od faktycznych przerw. Aby wprowadzić przerwę, przełącz dwukrotnie." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mostra dias sem dados e dias com lapsos de forma diferente. Para inserir um lapso, clique duas vezes." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Отличать дни без данных от фактических пропусков. Чтобы ввести пропуск, переключите дважды." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Odlíšte dni bez údajov od skutočných prerušení. Ak chcete zadať prerušenie, dvakrát prepnite." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Razlikujte dneve brez podatkov od dejanskih zamud. Če želite vnesti presledek, dvakrat preklopite." } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Razlikuje dane bez podataka sa stvarnim propuštanjem. Za preskok, potvrdite dva puta." } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Разликује дане без података са стварним пропуштањем. За прескок, потврдите два пута." } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Skilj dagar utan data från faktiska misslyckanden. För att ange ett misslyckanden, växla två gånger." } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "தகவல் இல்லாத நாட்களை வேறுபடுத்து.தவித்தலை பதிவிட, இருமுறை தொடவும்." } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Eksik verilerle boş günleri ayırt etmenizde yardımcı olur. Boş gün girmek için iki kere işaretleme yapın." } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Відрізняти дні без даних від фактичних пропусків. Щоб увести пропуск, перемкніть двічі." } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Phân biệt những ngày không có dữ liệu với những lần trôi đi thực tế. Để nhập một lần trôi đi, hãy bật/tắt hai lần." } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "区分无数据和未完成习惯的日期。要输入一个习惯未完成，请切换两次。" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "將沒有數據的天數與逾期者分開。要更改逾期設定，請切換兩次。" } }
      }
    },
