        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Välj offentlig säkerhetskopieringsmapp" } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "பொது காப்பு கோப்புறையைத் தேர்ந்தெடுக்கவும்" } },
        "te-IN" : { "stringUnit" : { "state" : "translated", "value" : "పబ్లిక్ బ్యాకప్ ఫోల్డర్‌ను ఎంచుకోండి" } },
