        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "നിങ്ങളുടെ ഹോം സ്ക്രീനിൽ വിജറ്റുകളെ കൂടുതൽ സുതാര്യമോ അതാര്യമോ ആക്കുന്നു." } },
