        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Чиста црна у тамној теми" } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Använd svart färg i nattläge" } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "இருள் பாங்கில் முழு கருப்பு நிறத்தை பயண்படுத்து" } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Gece modunda saf siyah kullan" } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Користати цілком чорне тло у нічному режимі" } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Sử dụng màu đen thuần trong chế độ ban đêm" } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "在深色主题中使用纯黑色" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "在夜間模式中使用深色設定" } }
      }
    },
    "pure_black_description" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "يستبدل خلفيات رمادية مع أسود نقي في الوضع الليلي. يقلل من استهلاك البطارية في الهواتف مع شاشة AMOLED. ." } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Заменя сивите фонове с чисто черни при тъмна тема. Намаля разхода на батерията при телефони с AMOLED дисплеи." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Reemplaça fons grisos per negre pur en el mode nocturn. Redueix consum de bateria en telèfons amb pantalla AMOLED." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Nahrazuje v temném motivu šedé pozadí čistou černou. Snižuje spotřebu baterie v telefonech s AMOLED displejem." } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Erstatter grå baggrunde med ren sort i nat-tilstand. Reducerer batteriforbruget i telefoner med AMOLED skærm." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Ersetzt im Nachtmodus das Grau des Hintergrunds durch Schwarz. Reduziert den Stromverbrauch von Smartphones mit AMOLED Displays." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Αντικαθιστά τα γκρί υπόβαθρα με απόλυτα μαύρα σε νυχτ.λειτουργία. Μειώνει την κατανάλωση μπαταρίας σε συσκευές με οθόνη AMOLED." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Replaces gray backgrounds with pure black in dark theme. Reduces battery usage in phones with AMOLED display." } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Anstataŭigas grizajn fonojn per pura nigra en malhela temo. Reduktas baterian uzon en telefonoj kun AMOLED-ekrano." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Reemplaza fondos grises por color negro en modo nocturno. Reduce el consumo de batería en teléfonos con pantalla AMOLED." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Atzeko plano grisak beltz hutsez aldatzen ditu azal ilunean. Bateriaren erabilera gutxitzen du AMOLED duten gailuetan." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "جایگزینی پس‌زمینه خاکستری با سیاه خالص در حالت تیره. استفاده از باتری را در گوشی‌های با صفحه نمایش AMOLED کاهش می‌دهد." } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Korvaa harmaat taustat puhtaalla mustalla tummalla teemalla. Vähentää akun käyttöä puhelimissa AMOLED-näytöllä." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Remplace le fond gris par un noir pur dans le mode nuit ; cela réduit l’usage de la batterie des appareils ayant un écran AMOLED." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "החלפת הרקע האפור בערכת הנושא הכהה לשחור מוחלט. מפחית את צריכת הסוללה במכשירים עם תצוגת AMOLED." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "\"\nरात मोड में शुद्ध काले रंग के साथ ग्रे पृष्ठभूमि में बदलें.  अमोलेड प्रदर्शन के साथ फोन में बैटरी उपयोग कम कर देता है ।\"" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Zamjenjuje sivu pozadinu sa crnom u noćnom načinu. To smanjuje potrošnju bateriju na uređajima s AMOLED zaslonima." } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "A szürke hátteret tiszta feketére cseréli éjszakai módban. Csökkenti az energiafelhasználást AMOLED kijelzős telefonokon." } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Ganti warna latar abu-abu dengan warna hitam pada mode malam. Mengurangi penggunaan baterai pada layar AMOLED." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Sostituisce gli sfondi grigi con sfondi neri nella modalità notte. Riduce il consumo di batteria nei dispositivi con schermo AMOLED." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "夜間モードで灰色の背景を完全な黒で置き換えます。AMOLED ディスプレイの電話でバッテリー使用量を抑えます。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "მუქ რეჟიმში რუხი ფონები სუფთა შავით ჩანაცვლდება. AMOLED-ეკრანიან ტელეფონებში ეს ელემენტის ენერგიას ზოგავს." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "야간 모드의 회색 배경을 검정색으로 대체합니다. AMOLED 디스플레이를 사용하는 기기에서 배터리 사용량을 감소시킵니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "ഇരുണ്ട തീമിൽ ചാരനിറത്തിലുള്ള പശ്ചാത്തലം ശുദ്ധമായ കറുപ്പ് ഉപയോഗിച്ച് മാറ്റിസ്ഥാപിക്കുക.  അമോൾഡ് ഡിസ്പ്ലേ ഉള്ള ഫോണുകളിൽ ബാറ്ററി ഉപയോഗം കുറയ്ക്കുക." } },
        "nb-NO" : { "stringUnit" : { "state" : "translated", "value" : "Bytter ut grå bakgunner med helt svarte i nattmodus. Reduserer betteribruk hos telefoner med AMOLED-skjerm." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Vervangt grijze achtergronden door puur zwart in het donkere thema. Vermindert batterijgebruik bij telefoons met AMOLED scherm." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Zamienia szare tła na pełną czerń w trybie nocnym. Zmniejsza zużycie baterii w telefonach z ekranem AMOLED." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Substitui os tons de cinza por preto puro em modo noturno. Economiza bateria em telefones com tela AMOLED." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Substitui os fundos cinzentos por pretos puros no modo noturno. Reduz a utilização da bateria em telemóveis com ecrã AMOLED." } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Înlocuiește fundalurile gri cu negru pur în modul întunecat. Reduce utilizarea bateriei la telefoanele cu ecran AMOLED." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Заменяет серый фон на подлинный чёрный в ночном режиме. Сокращает расход батареи в телефонах с дисплеем AMOLED." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Nahrádza sivé pozadie čisto čiernym v tmavej téme. Znižuje spotrebu batérie v telefónoch s displejom AMOLED." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Zamenja siva ozadja s popolno črnino v nočnem načinu. Zmanjša porabo baterije na telefonih z AMOLED zasloni." } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Menja sivu pozadinu sa čistom crnom u tamnoj temi. Smanjuje potrošnju baterije kod telefona sa AMOLED ekranom." } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Мења сиву позадину са чистом црном у тамној теми. Смањује потрошњу батерије код телефона са АМОЛЕД екраном." } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Ersätter gråa bakgrunder med svart färg i nattläge. Reducerar batterianvändningen för telefoner med AMOLED-skärm." } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "இதன் மூலம் செயலியில் உள்ள பழுப்பு பின்புலங்கள் நீக்கப்பட்டு முழுவதும் கருப்பு நிற பின்புலங்களாக மாற்றப்படும். இது AMOLED திரை கொண்ட கைப்பேசிகளில் மின்கல பயன்பாட்டை குறைக்கும்." } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Gece modunda gri arkaplanı saf siyah ile değiştirir. AMOLED ekranlı cihazlarda pil kullanımını azaltır." } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Замінює сіре тло на цілком чорне у нічному режимі. Зменшує використання батареї в телефонах із дисплеєм AMOLED." } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Thay thế nền màu xám bởi màu đen thuần trong chế độ ban đêm. Giảm thiểu việc sử dụng pin của điện thoại có màn hình AMOLED." } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "以纯黑色背景代替深色主题中的灰色背景。\n这可以降低 AMOLED 屏幕手机的耗电量。" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "在夜間模式中，使用黑色背景取代灰色背景。這樣可以減少 AMOLED 螢幕手機的電量消耗。" } }
      }
    },
