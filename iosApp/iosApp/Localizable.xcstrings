        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Generera en fil som innehåller all din data. Denna fil kan importas tillbaka till appen." } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "உங்களின் அனைத்து தரவுகளையும் கொண்ட ஒரு ஆவணம் உருவாக்கப்படும். இந்த ஆவணத்தை மீண்டும் இந்த செயலியில் இறக்குமதி செய்யலாம்." } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Tüm verilerini içeren bir dosya oluştur. Bu dosya tekrar içeri aktarılabilir." } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Створює файл, що містить усі Ваші дані. Цей файл можна імпортувати назад." } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Tạo ra một tệp chứa tất cả dữ liệu của bạn. Tệp này có thể nhập lại." } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "生成一个包含所有数据的文件。该文件可以重新导入。" } },
