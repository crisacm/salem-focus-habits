    "intro_description_1" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "يساعدك متتبع العادات loop في بَدْء عادات جيدة والحفاظ عليها.   " } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Loop Следене на навици ви помага да създавате и поддържате добри навици." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker t'ajuda a crear i mantenir bons hàbits" } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker vám pomůže vytvořit a udržet dobré návyky." } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker hjælper dig med at holde gode vaner." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker hilft dir dabei, gute Gewohnheiten zu entwickeln." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Το Loop - Καταγραφή Συνηθειών σας βοηθάει να δημιουργήσετε και να διατηρήσετε καλές συνήθειες." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Salem helps you create and maintain good habits." } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker helpas vin krei kaj konservi bonajn kutimojn." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Loop Analizador de Hábitos te ayuda a crear y mantener buenos hábitos." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker-ek ohitura onak hartzen eta mantentzen laguntzen dizu." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "عادت‌سنج لوپ به شما کمک می‌کند تا برای خودتان عادت‌های خوبی بسازید. " } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker auttaa sinua luomaan ja ylläpitämään hyviä rutiineja." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Loop - Suivi d'habitudes vous aide à créer et maintenir de bonnes habitudes." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "‏”Loop לניהול הרגלים“ מסייע לך להתחיל ולשמר הרגלים טובים." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "लूप हैबिट ट्रैकर नई और अच्छी आदतों को बनाए रखने मे मदद करता है ।" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker vam pomaže stvoriti i održavati dobre navike." } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "A Loop Habit Tracker segít a jó szokások kialakításában és azok fenntartásában" } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker membantu menciptakan dan memelihara Kebiasaan baikmu." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker ti aiuta a creare e mantenere delle buone abitudini." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "ループ習慣トラッカーは、良い習慣を作り、維持するのに役立ちます。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "Loop — ჩვევების ტრეკერი: ხელშემწყობი კარგი ჩვევების გამომუშავებასა და შენარჩუნებისათვის." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "Loop은 당신이 좋은 습관을 만들고 유지하도록 도와줍니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "നല്ല ശീലങ്ങൾ സൃഷ്ടിക്കാനും നിലനിർത്താനും ലൂപ്പ് ഹാബിറ്റ് ട്രാക്കർ നിങ്ങളെ സഹായിക്കുന്നു." } },
        "nb-NO" : { "stringUnit" : { "state" : "translated", "value" : "Loop Vaneoversikt hjelper deg med å lage og beholde gode vaner." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker helpt je om goede gewoontes te creëren en te onderhouden." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Śledzenie nawyków Loop pozwala Ci na utworzenie i prowadzenie dobrych nawyków." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Loop é um aplicativo que te ajuda a criar e manter bons hábitos." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Loop é uma aplicação que o ajuda a criar e manter bons hábitos." } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker te ajută să creezi și să menții obiceiurile bune." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker помогает вам заводить и поддерживать полезные привычки." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker vám pomáha vytvárať a udržiavať dobré návyky." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Loop Sledilnik Navad vam pomaga ustvariti in vzdrževati dobre navade." } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "„Loop“ vam pomaže da stvorite i održite zdrave navike." } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "„Loop“ вам помаже да створите и одржите здраве навике." } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Loop Habit Tracker hjälper dig att skapa och bibehålla goda vanor." } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "இந்த செயலி நல்ல பழக்க வழக்கங்களை துவங்க மற்றும் தொடர உதவுகிறது." } },
        "te-IN" : { "stringUnit" : { "state" : "translated", "value" : "లూప్ అలవాటు ట్రాకర్ మంచి అలవాట్లను సృష్టించడానికి మరియు నిర్వహించడానికి మీకు సహాయపడుతుంది." } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Loop Alışkanlık Takibi, iyi alışkanlıklar edinmene ve sürdürmene yardımcı olur." } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Трекер звичок Loop допомагає Вам розвивати і підтримувати корисні звички." } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Theo dõi thói quen Loop giúp bạn tạo ra và duy trì những thói quen tốt." } },
