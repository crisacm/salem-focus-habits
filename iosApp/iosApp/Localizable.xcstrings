        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "நாளை, நள்ளிரவை தாண்டி சில மணிநேரங்கள் நீட்டிக்கவும்" } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Yeni günü gece yarısından birkaç saat sonra başlat" } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Продовжити день на кілька годин після опівночі" } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Kéo dài ngày thêm một vài giờ sau nửa đêm" } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "将一天延长到午夜后的几个小时" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "將一天延長到午夜過後幾個小時" } }
      }
    },
    "pref_midnight_delay_description" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "انتظر حتى 3:00 صباحاً لعرض يوم جديد. مفيد إذا كنت عادة تذهب إلى السكون بعد منتصف الليل. يتطلب إعادة تشغيل التطبيق." } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Изчакване до 3:00 часа сутринта за показване на нов ден. Полезно, ако обичайно си лягате да спите след полунощ. Изисква рестартиране на приложението." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Esperar fins a les 3:00 per mostrar un nou dia. Útil si normalment vas a dormir després de la mitjanit. Requereix el reinici de l'aplicació." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Počkat do tří ráno pro zobrazení nového dne. Užitečné, pokud chodíte spát po půlnoci. Vyžaduje restartování aplikace. " } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Vent til 3:00 for at vise en ny dag. Nyttigt, hvis du typisk går i seng efter midnat. Kræver genstart af app." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Bis 3:00 Uhr warten, bevor ein neuer Tag angezeigt wird. Nützlich, wenn du normalerweise nach Mitternacht schlafen gehst. Benötigt einen Neustart der App." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Περιμένετε μέχρι τις 3:00 πμ για να εμφανιστεί μια νέα μέρα. Χρήσιμο αν συνήθως πάτε για ύπνο μετά τα μεσάνυχτα. Απαιτεί επανεκκίνηση της εφαρμογής." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Wait until 3:00 AM to show a new day. Useful if you typically go to sleep after midnight. Requires app restart." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Esperar hasta las 3:00 AM para mostrar un nuevo día. Útil si normalmente vas a dormir después de medianoche. Requiere reiniciar la aplicación." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Itxaron goizeko 3:00ak arte egun berri bat erakusteko. Erabilgarria normalean gauerdia pasata lotara joaten bazara. Aplikazioa berrabiarazi behar da." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "تا ساعت ۳ نیمه‌شب برای نمایش یک روز جدید صبر می‌کند. اگر معمولاً بعد از نیمه‌شب می‌خوابید، برای شما می‌تواند مفید باشد. نیازمند راه‌اندازی مجدد برنامه است." } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Odota kello 3.00 asti ennen uuden päivän näyttämistä. Hyödyllinen jos menet nukkumaan yleensä keskiyön jälkeen. Vaatii sovelluksen uudelleenkäynnistyksen." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Attendre jusqu'à trois heures du matin pour changer de jour. Très utile si vous avez l'habitude d'aller dormir après minuit. (Redémarrage nécessaire)" } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "המתנה עד 3:00 לפני הצגת יום חדש. שימושי אם לרוב הולכים לישון אחרי חצות. דורש הפעלה מחדש של היישום." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "नया दिन दिखाने के लिए सुबह 3:00 बजे तक प्रतीक्षा करें। उपयोगी अगर आप आमतौर पर आधी रात के बाद सोने जाते हैं। ऐप पुनरारंभ की आवश्यकता होगी।" } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Várjon hajnali 3 -ig, hogy új napot mutasson. Hasznos, ha általában éjfél után fekszik le. Az alkalmazás újraindítását igényli." } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Tunggu sampai jam 3 pagi untuk menampilkan hari yang baru. Berguna jika kamu biasanya tidur setelah tengah malam. Aplikasi perlu dimulai ulang." } },
        "is-IS" : { "stringUnit" : { "state" : "translated", "value" : "Bíða til klukkan 03:00 til að sýna nýjan dag. Gagnlegt ef þú ferð að sofa eftir miðnætti. Krefst endurræsingar forritsins." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Attendere fino alle 3:00 per mostrare il nuovo giorno. Utile se solitamente vai a dormire dopo mezzanotte. È necessario riavviare l'app." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "一日の始まりを午前3時にします。よく午前0時以降に就寝する場合に役立ちます。アプリの再起動が必要です。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "ახალი დღის 03:00 საათზე დაწყება. ხელსაყრელია თუ ზოგადად შუაღამის შემდეგ იძინებ. საჭიროებს აპლიკაციის გადატვირთვას." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "오전 3시를 기점으로 하루가 변경됩니다. 자정 이후 잠드는 경우 유용합니다. 변경시 앱 재시작 후 적용됩니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "ഒരു പുതിയ ദിവസം കാണിക്കാൻ 3:00 AM വരെ കാത്തിരിക്കുക.  നിങ്ങൾ സാധാരണയായി അർദ്ധരാത്രിക്ക് ശേഷം ഉറങ്ങാൻ പോകുകയാണെങ്കിൽ ഉപയോഗപ്രദമാണ്.  ആപ്പ് പുനരാരംഭിക്കേണ്ടതുണ്ട്." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Wacht tot 3:00 uur om een nieuwe dag te beginnen. Handig als je normaal gesproken na middernacht gaat slapen. Dit vereist het opnieuw opstarten van de app." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Poczekaj do 3:00, aby pokazać nowy dzień. Przydatne, jeśli zwykle kładziesz się spać po północy. Wymaga ponownego uruchomienia aplikacji." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Espere até às 3:00 para mostrar um novo dia. Útil se você costuma dormir depois da meia-noite. Requer reinicialização do aplicativo." } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Așteaptă până la ora 3:00 dimineața pentru a arăta o nouă zi. O funcție utilă dacă în mod normal obișnuiești să mergi la somn după miezul nopții. Necesită repornirea aplicației." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Подождать до 3:00 перед показом нового дня. Полезно, если вы обычно ложитесь спать после полуночи. Требуется перезапуск приложения." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Na zobrazenie nového dňa počkajte do 3:00. Užitočné, ak zvyčajne chodíte spať po polnoci. Vyžaduje reštart aplikácie." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Počakajte do 3.00, da prikažete nov dan. Uporabno, če greste običajno spat po polnoči. Zahteva ponovni zagon aplikacije." } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Čeka do 03:00 da pokaže novi dan. Korisno ako obično idete na spavanje posle ponoći. Zahteva ponovno pokretanje." } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Чека до 03:00 да покаже нови дан. Корисно ако обично идете на спавање после поноћи. Захтева поновно покретање." } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Vänta till 3:00 innan en ny dag visas. Användbart om du vanligtvis går och lägger dig efter midnatt. Kräver omstart av appen." } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "புதிய நாளைக் காண்பிக்க அதிகாலை 3:00 மணிவரை காத்திருக்கவும். நீங்கள் பொதுவாக நடுஇரவுக்கு பின் உறங்குபவரரெனில் உபயோகமானது. பயன்பாட்டை மறுதுவக்கம் செய்தல் அவசியமானது" } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Yeni gün saat 03:00'ten sonra başlar. Geç saatlerde uyuyanlar için kullanışlıdır. Uygulamanın yeniden başlatılmasını gerektirir." } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Почекати до 3:00 перед показом нового дня. Корисно, якщо ви зазвичай лягаєте спати після опівночі. Потрібно перезапустити програму." } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Chờ đến 3:00 sáng để hiện một ngày mới. Rất hữu ích nếu bạn thường đi ngủ sau nửa đêm. Yêu cầu khởi động lại ứng dụng." } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "凌晨 3 点后再显示新的一天。如果你通常在午夜后入睡，这会很有用。重启应用后生效。" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "凌晨3點後再顯示新的一天。如果你通常在午夜以後才睡，這能幫上忙。重新啟動後才生效。" } }
      }
    },
