    "intro_description_2" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "كل يوم، بعد أداء عادتك، ضع علامة عليها في التطبيق." } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Всеки ден, след изпълнението на навика, поставете отметка в приложението." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Cada dia, després de complir el teu hàbit, posa una marca amb l'aplicació." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Každý den po splnění zvyku si ho v aplikaci zaškrtněte." } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Hver dag, efter at have udført din vane, skal du sætte et flueben i app'en." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Hake die Gewohnheit jeden Tag in der App ab, nachdem du sie erledigt hast." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Κάθε μέρα, με το πέρας της συνήθειας, βάλτε ένα τικ στην εφαρμογή." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Every day, after performing your habit, put a checkmark on the app." } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Ĉiutage, post plenumi vian kutimon, metu markostampon en la app." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Cada día, después de realizar tu hábito, pon una marca en la aplicación." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Egunero, zure ohitura egin ostean, jarri ezazu egiaztatze marka bat aplikazioan." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "هر روز بعد از انجام عادت، آن را در برنامه تیک بزنید. " } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Joka päivä, suoritettuasi rutiinin, merkitse se sovellukseen." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Chaque jour, après avoir réalisé votre habitude, cochez-la sur l'application." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "בכל יום, לאחר ביצוע ההרגל, מסמנים את זה ביישום." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "हर दिन, अपनी आदत के प्रदर्शन के बाद, ऐप पर एक सही का निशान डालें" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Svaki dan, nakon izvođenja vaše navike, postavite \"kvačicu\" u aplikaciji." } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Minden nap jelöld pipával az alkalmazásban, ahogy elvégeztél egy jó szokást." } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Berikan tanda centang setiap kali kamu selesai melakukannya." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Ogni giorno, dopo aver portato a termine la tua abitudine, spuntala nell'app." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "毎日、習慣を実行した後、アプリでチェックマークを付けます。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "ყოველდღიურად, როგორც კი ჩვევას შეასრულებ, ეს აპლიკაციაში ჩაინიშნე." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "매일 습관을 수행하고 앱에 기록하세요." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "എല്ലാ ദിവസവും, നിങ്ങളുടെ ശീലം നടപ്പിലാക്കിയ ശേഷം, ആപ്പിൽ ഒരു ചെക്ക്മാർക്ക് ഇടുക." } },
        "nb-NO" : { "stringUnit" : { "state" : "translated", "value" : "Hver dag, etter du utfører vanen din, sett en hake på appen." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Plaats iedere dag, na het uitvoeren van jouw gewoonte, een vinkje in de app." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Codziennie, po wykonaniu swojego nawyku, postaw znaczek w aplikacji." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Todo dia, depois de praticar o seu hábito, marque no aplicativo." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Todos os dias, após concluir o seu hábito, marque uma cruz na app." } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "În fiecare zi, după ce îndeplinești obiceiul, bifează-l în aplicație." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Каждый день, после выполнения вашей привычки, поставьте галочку в приложении." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Každý deň po vykonaní návyku pridajte začiarknutie v aplikácii." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Vsak dan, potem ko opravite vašo navado, vnesite kljukico v aplikacijo." } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Svakog dana, nakon što obavite zacrtano, otkačite polje u aplikaciji." } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Сваког дана, након што обавите зацртано, откачите поље у апликацији." } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Efter varje dag när du utfört din vana så markerar du den i appen." } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "தினமும் உங்கள் புதிய பழக்கத்தை முடித்தவுடன் இந்த செயலியில் அதை குறிக்கவும்." } },
        "te-IN" : { "stringUnit" : { "state" : "translated", "value" : "ప్రతి రోజు, మీ అలవాటు చేసిన తర్వాత, అనువర్తనంలో చెక్‌మార్క్ ఉంచండి." } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Alışkanlığın gerçekleştiği günleri işaretle." } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Щодня, після виконання Вашої звички, ставте пташку в програмі." } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Mỗi ngày, sau khi thực hiện các thói quen của bạn, hãy đánh dấu vào ứng dụng." } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "每当你完成一项习惯后，就在应用上做一个标记" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "每天完成你的習慣後，進入 APP 來打個勾吧。" } }
      }
    },
