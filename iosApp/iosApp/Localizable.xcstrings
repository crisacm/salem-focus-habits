        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Генерира файл, който съдържа всичките ви данни. Този файл може да бъде импортиран обратно." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Genera un fitxer que contè totes les teves dades. Aquest fitxer pot tornar-se a importar." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Generuje soubor, který obsahuje veškerá vaše data. Tento soubor může být importován zpět." } },
