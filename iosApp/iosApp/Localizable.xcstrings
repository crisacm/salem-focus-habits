    "hint_drag" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "لإعادة ترتيب القوائم، أضغط اسم من هذه العادة، ثم اسحبه إلى المكان الصحيح.   " } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "За да пренаредите записите, натиснете и задръжте върху името на навика и го придърпайте до правилното място." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Per a ordenar les entrades, prem i mantè sobre el nom de l'hàbit, després arrossega'l al lloc correcte." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Pro přeřazení položek stiskněte a podržte název zvyku a přesuňte ho na správné místo." } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "For at omarrangere poster, tryk og hold på navnet på den vane, og træk den til det korrekte sted." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Um Einträge umzusortieren, tippe, halte und ziehe sie an die richtige Stelle." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Αναδιατάξετε τις συνήθειες πατώντας παρατεταμένα στο όνομα και σύροντας στην σωστή θέση." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "To rearrange the entries, press-and-hold on the name of the habit, then drag it to the correct place." } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Por reordigi la enskribojn, premi kaj tenu la nomon de la kutimo, poste trenu ĝin al la ĝusta loko." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Para reorganizar las entradas, mantén presionado el nombre del hábito y luego arrástralo al lugar correcto." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Sarrerak berrantolatzeko, sakatu eta mantendu ohituraren izena, ondoren mugi ezazu leku aproposera." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "برای جابجایی عناوین، انگشتتان را روی نام عادت مورد نظر بگذارید و نگه دارید، سپس آن را به محل صحیح بکشید. " } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Muokkaa merkintöjen järjestystä: valitse tavan nimi ja vedä se oikeaan paikkaan." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Pour réordonner les habitudes, faites un appui long sur le nom de l'habitude et placez-la à la bonne place." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "אפשר לשנות את סדר ההרגלים בעזרת לחיצה ארוכה על הרגל וגרירתו למקום הרצוי." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "\"\nप्रविष्टियों को पुनर्व्यवस्थित करने के लिए, आदत के नाम पर प्रेस करें और सही जगह पर खींचें।\"" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Za razmještanje unosa, pritisnite i držite naziv navike, pa ih premjestite na točno mjesto." } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Az elemek újrarendezéséhez a koppints a szokás nevére, majd húzd a megfelelő helyre." } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Untuk mengatur urutan, tekan dan tahan judul Kebiasaan lalu tempatkan pada posisi yang kamu inginkan." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Per riordinare le voci, tieni premuto sul nome dell'abitudine, poi spostala nella posizione corretta." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "エントリーを並べ替えるには、習慣の名前を長押しして、正しい場所にドラッグしてください。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "ჩვევის ადგილის გადასანაცვლებლად სახელს ხანგრძლივად დააჭირე და სასურველ ადგილას დასვი." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "목록의 순서를 재배치하려면, 습관의 제목을 길게 누르고 다른 위치로 드래그하면 됩니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "എൻട്രികൾ പുനഃക്രമീകരിക്കാൻ, ശീലത്തിന്റെ പേരിൽ അമർത്തിപ്പിടിക്കുക, തുടർന്ന് അത് ശരിയായ സ്ഥലത്തേക്ക് വലിച്ചിടുക." } },
        "nb-NO" : { "stringUnit" : { "state" : "translated", "value" : "For å sortere innleggene, trykk og hold på navnet til vanen, deretter dra den til det korrekte stedet." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Om de rijen te ordenen, houdt de gewoonte ingedrukt en sleep het naar de gewenste plek." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Aby zmienić kolejność naciśnij i przytrzymaj na nazwie nawyku i przesuń go na odpowiednie miejsce." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Para mudar a ordem dos hábitos, aperte no nome do hábito, sustente e arraste." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Para reorganizar a lista, mantenha pressionado o nome do hábito e arraste-o para o lugar certo." } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Pentru a rearanja obiceiurile, apasă și ține numele obiceiului, apoi trage-l în locul corect." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Чтобы поменять порядок записей, нажмите и удерживайте название записи, затем перетащите её на нужное место." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Pre zmenu usporiadania záznamov, stlačte a podržte názov návyku a potom ho presuňte na správne miesto." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Če želite preurediti vnose, pritisnite-in-držite na ime navade, nato pa jo povlecite na željeno mestu." } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Pritisnite i držite naziv navike pa je prevucite da biste ih preuredili." } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Притисните и држите назив навике па је превуците да бисте их преуредили." } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "För att flytta på poster - tryck och håll nere på den vana du vill flytta, sedan flytta den till önskad plats." } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "பதிவுகளை மறுசீரைமக்க, தேவையான பழக்க பதிவின் மீது அழுத்தி பிடித்து பின் தேவையான இடத்திற்கு அதை இழுக்கவும்." } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Girdileri sıralamak için, alışkanlık adının üstüne basılı tut ve doğru yere sürükle." } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Аби змінити порядок записів, натисніть і утримуйте назву запису, опісля перетягніть запис на потрібне місце." } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Để sắp xếp lại các mục, nhấn giữ tên thói quen, sau đó kéo tới vị trí chính xác." } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "如果要重新排列习惯，按住习惯的名字拖到想要的位置" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "如果要重新排列習慣，可以將其拖曳到理想的位置" } }
      }
    },
    "hint_landscape" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "يمكنك ان ترى المزيد أيام عن طريق وضع الهاتف في وضع أفقي.   " } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Може да виждате повече дни като обърнете телефона си в хоризонтално положение." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Pots veure més dies posant el teu telèfon en orientació apaisada." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Můžete vidět více dnů otočením telefonu na šířku." } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Du kan se flere dage ved at sætte telefonen i liggende tilstand." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Du kannst mehr Tage sehen, wenn du dein Smartphone quer hältst." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Μπορείτε να δείτε περισσότερες ημέρες στην οριζόντια προβολή." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You can see more days by putting your phone in landscape mode." } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Vi povas vidi pliajn tagojn enmetante vian telefonon en pejzaĝa reĝimo." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Puedes ver más días al poner tu teléfono en modo horizontal." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Egun gehiago ikus ditzakezu zure gailua paisai moduan jarriz." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "با قرار دادن گوشی در حالت افقی می‌توانید روزهای بیشتری را ببینید. " } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Näe lisää päiviä kääntämällä puhelimesi pitkittäin." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Vous pouvez voir plus de jours en mettant votre téléphone en mode paysage." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "אפשר לסובב את המסך לרוחב ולראות ימים נוספים." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "\"\n अपने फोन को लांडसकपे मोड मे रख कर आप अधिक दिनों से देख सकते हैं\"" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Možete vidjeti više dana prebacivanjem uređaja u vodoravnu orijentaciju." } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Több nap válik láthatóvá, ha fekvő módba állítod a telefonod kijelzőjét." } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Kamu bisa melihat lebih banyak hari dengan mengubah posisi ponsel menjadi mode landscape." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Puoi vedere più giorni mettendo il tuo telefono orizzontale." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "お使いの携帯電話を横置きモードにすることで、より多くの日数を見ることができます。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "ტელეფონს ჰორიზონტალურად თუ დაიჭერ მეტი დღის ნახვას შეძლებ." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "가로 모드에서는 더 많은 날짜를 볼 수 있습니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "നിങ്ങളുടെ ഫോൺ ലാൻഡ്‌സ്‌കേപ്പ് മോഡിൽ വെച്ചാൽ നിങ്ങൾക്ക് കൂടുതൽ ദിവസം കാണാൻ കഴിയും." } },
        "nb-NO" : { "stringUnit" : { "state" : "translated", "value" : "Du kan se flere dager ved å sette telefonen din i landskapsmodus." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Je kunt meer dagen zien door de telefoon in landschapsmodus te zetten." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Możesz zobaczyć więcej dni trzymając telefon poziomo." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Para ver mais dias, coloque seu aparelho em modo paisagem." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Pode ver mais dias se utilizar o telemóvel em modo paisagem." } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Poți vedea mai multe zile în modul peisaj." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "В горизонтальном режиме отображается больше дней." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Môžete vidieť viac dní otočením telefónu do režimu na šírku." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Ogledate si lahko več dni, s tem da telefon postavite v ležeči načinu." } },
