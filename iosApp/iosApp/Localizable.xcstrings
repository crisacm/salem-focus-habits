    "reverse_days_description" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "عرض أيام في ترتيب عكسي على الشاشة الرئيسية. " } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Показва дните на основния екран в обратен ред" } },
