    "no_public_backup_folder_selected" : {
      "localizations" : {
        "af-ZA" : { "stringUnit" : { "state" : "translated", "value" : "Geen vouer gekies nie" } },
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "لم يتم اختيار مجلد" } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Не е избрана папка" } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "No s'ha seleccionat cap carpeta" } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Nebyla vybrána žádná složka" } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Ingen mappe valgt" } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Kein Ordner ausgewählt" } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Δεν επιλέχθηκε φάκελος" } },
