    "led_notifications_description" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "إظهار ضوء وامض للتذكيرات. متوفر فقط في الهواتف المزودة بمصابيح إشعارات LED. " } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Показва мигаща светлина за напомняния. Налична само за телефони с LED светлини за известяване." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Mostra una llum parpallejant per als recordatoris. Només disponible en telèfons amb llums de notificació LED." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Bliká při upozornění. Pouze pro telefony s LED notifikačními světly." } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Viser et blinkende lys til påmindelser. Kun tilgængelig i telefoner med LED-notifikationslyskilder." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Blinkende LED für Erinnerungen anzeigen. Nur verfügbar in Geräten mit LED Benachrichtigungs-LED." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Αναβοσβήνει μια φωτεινή ένδειξη για υπενθυμίσεις. Διαθέσιμο μόνο σε τηλέφωνα με φωτεινές ενδείξεις LED." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows a blinking light for reminders. Only available in phones with LED notification lights." } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Montras palpebrumantan lumon por memorigiloj. Nur havebla en telefonoj kun LED-sciigaj lumoj." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Muestra una luz intermitente para recordatorios. Solo disponible en teléfonos con luces de notificación LED." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Oroigarri gisa argia keinuka erakusten du. Jakinarazpen LED argiak dituzten telefonoetan bakarrik dago erabilgarri." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "یک چراغ چشمک‌زن برای یادآوری‌ها نشان می‌دهد. فقط در گوشی‌های دارای چراغ‌های اعلان LED موجود است." } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Näyttää vilkkuvan valon ilmoituksista. Vain puhelimissa joissa on LED-ilmoitusvalo." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Affiche une lumière clignotante pour les rappels. Uniquement disponible dans les téléphones avec lumière de notification LED." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "להצגת אור מהבהב לתזכורות. התכונה זמינה רק בטלפונים עם נורות LED להתראות." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "स्मरण के लिए एक चमकती रोशनी दिखाता है। यह केवल एलईडी नोटिफिकेशन लाइट वाले फोन में उपलब्ध है।" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Pali bljeskalicu za podsjetnike. Dostupno samo na uređajima s LED svjetlosnim obavijestima." } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Emlékeztetés villogó fénnyel. Csak olyan telefonon működik amelyen van értesítési LED." } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Memperlihatkan lampu yang berkedip sebagai pengingat. Hanya tersedia di perangkat dengan lampu notifikasi LED." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Mostra una luce lampeggiante per i promemoria. Disponibile solo nei telefoni con luci di notifica a LED." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "リマインダーで通知LEDを点滅します。通知LEDのある携帯でのみ有効です。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "ციმციმას რთავს შემახსენებელი შეტყობინებებისთვის. ხელმისაწვდომია მხოლოდ ისეთი მოწყობილობებისთვის, რომლებსაც შეტყობინების LED აქვთ." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "리마인더가 있으면알림 표시등이 깜박입니다. LED 알림 표시등이있는 전화기에서만 사용할 수 있습니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "ഓർമ്മപ്പെടുത്തലുകൾക്കായി മിന്നുന്ന പ്രകാശം കാണിക്കുന്നു.  LED നോട്ടിഫിക്കേഷൻ ലൈറ്റുകൾ ഉള്ള ഫോണുകളിൽ മാത്രമേ ലഭ്യമാകൂ." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Toont een knipperend licht voor herinneringen. Alleen beschikbaar in telefoons met LED-meldingsverlichting." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Wyświetla migające światło dla przypomnień. Dostępne jedynie w telefonach z diodą LED." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mostra uma luz piscando para lembretes. Disponível apenas em telefones com luzes de notificação LED." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Mostra uma luz piscando para lembretes. Disponível apenas em telefones com luzes de notificação LED." } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Afișează o lumină intermitentă la notificare. Disponibil doar în telefoanele care au bec LED pentru notificări." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Мигать индикатором для напоминаний. Доступно только в телефонах со светодиодным индикатором событий." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Zobrazuje blikajúce svetlo pre pripomenutia. K dispozícii iba v telefónoch s kontrolkami LED." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Prikaže utripajočo luč za opomnike. Na voljo samo v telefonih z LED lučkami za obvestila." } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Prikazuje trepćuće svetlo kao podsetnik. Samo na telefonima sa LED svetlom za obaveštavanje." } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Приказује трепћуће светло као подсетник. Само на телефонима са ЛЕД светлом за обавештавање." } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Visar ett blinkande ljus för påminnelser. Endast tillgängligt för telefoner med LED-indikator." } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "நினைவூட்டல்களுக்கு விளக்கு (வசதி உள்ளதெனில்) அணைந்து அணைந்து எரியும் " } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Hatırlatıcılar için yanıp sönen bir ışık gösterir. Yalnızca LED bildirim ışığı olan telefonlarda kullanılabilir." } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Блимає для сповіщень. Доступне тільки в телефонах зі світловими LED-нагадуваннями." } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Hiển thị đèn nhấp nháy cho lời nhắc. Chỉ có sẵn trong điện thoại có đèn thông báo LED." } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "有提醒时，呼吸灯会闪烁提示。仅限于有 LED 通知呼吸灯的手机。" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "顯示閃爍燈光提醒。僅限於有內建 LED 通知燈的手機。" } }
      }
    },
