        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Экспортировать полную резервную копию" } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Exportovať celú zálohu" } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Izvozi popolno varnostno kopijo" } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Napravi rezervnu kopiju" } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Направи резервну копију" } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Exportera backup" } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "ஆவணக் காப்பு நகல் முழுமையாக ஏற்றுமதி செய்" } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Tüm yedeği dışarı aktar" } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Експортувати повну резервну копію" } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Xuất bản sao lưu đầy đủ" } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "导出完整备份" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "匯出完整備份" } }
      }
    },
    "import_data_summary" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "تدعم النسخ الاحتياطي الكامل المصدرة من هذا التطبيق، فضلا عن الملفات التي تم إنشاؤها من Tickmate, HabitBull و Rewire. انظر التعليمات لمزيد من المعلومات.   " } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Поддържа пълни резервни копия експортирани чрез това приложение, както и файлове генерирани чрез Tickmate, HabitBull или Rewire. Вижте ЧЗВ за повече информация." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Suporta còpies de seguretat exportades per aquesta app, també fitxers generats per Tickmate, HabitBull o Rewire. Mira les Preguntes Freqüents per a més informació." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Podporuje plné zálohy z této aplikace, stejně jako soubory vygenerované aplikacemi od Tickmate, HabitBull nebo Rewire. Pro více informací konzultujte FAQ." } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Understøtter fuld backup eksporteret af denne app, samt filer genereret af Tickmate, HabitBull eller Rewire. Se FAQ for mere information." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Unterstützt vollständige Sicherungen dieser App, sowie von Tickmate, HabitBull und Rewire erzeugte Sicherungen. Siehe FAQ für weitere Informationen." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Υποστηρίζει πλήρως αντίγραφα ασφαλείας που έχουν εξαχθεί από την ίδια την εφαρμογή καθώς και από τα Tickmate, HabitBull και Rewire. Δείτε τις FAQ για περισσότερες πληροφορίες." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Supports full backups exported by this app, as well as files generated by Tickmate, HabitBull or Rewire. See FAQ for more information." } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Elportas plenajn sekurkopiojn eksportitajn de ĉi tiu aplikaĵo, same kiel dosierojn generitajn de Tickmate, HabitBull aŭ Rewire. Vidu DPO por pliaj informoj." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Es compatible con exportar copias de seguridad completas, así como archivos generados por Tickmate, HabitBull o Rewire. Mira el FAQ para más información." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Aplikazio honek esportatutako babes kopia osoak onartzen dira, baita Tickmate, HabitBull edo Rewirek sortutako fitxategiak ere. Ikusi ohito galderak informazio gehiago lortzeko." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "علاوه بر پشتیبان کامل تهیه شده توسط این برنامه، از پرونده‌های تولید شده توسط Tickmate، HabitbBull و یا Rewire هم پشتیبانی می‌شود. برای اطلاعات بیشتر سوالات متداول را ببینید." } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Tukee tästä sovelluksesta vietyjä täysiä varmuuskopioita, sekä tiedostoja jotka on luotu sovelluksissa Tickmate, HabitBull ja Rewire. Katso usein kysytyistä kysymyksistä lisätietoa." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Supporte les sauvegardes complètes générées par cette application, ainsi que les fichiers Tickmate, HabitBull et Rewire. Voir la FAQ pour plus d'informations." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "יש תמיכה בכל הגיבויים שיוצאו מיישום זה, וגם בקבצים שנוצרו על ידי Tickmate, ‏HabitBull או Rewire. למידע נוסף נא לעיין בשאלות הנפוצות." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "इस एप्लिकेशन के द्वारा निर्यात पूर्ण बैकअप को सपोर्ट करता है , साथ ही फाइलों टिक्कमते , हबिठबुल्ल या रिवाइयर द्वारा उत्पन्न फाइल्स को सपोर्ट करता है। अधिक जानकारी के लिए सामान्य प्रश्न देखें।" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Podržava sigurnosne kopije izvezene iz ove aplikacije, isto kao i datoteke generirane u Tickmate, HabitBull i Rewire. Pogledajte Pomoć i pitanja za više informacija." } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Támogatja a Loop Habit Tracker alkalmazás teljes mentéseit, illetve a Tickmate, HabitBull és Rewire alkalmazások formátumait is. További információt a GYIK-ben találsz." } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Mendukung ekspor data dan file dari aplikasi Tickmate, HabitBull atau Rewire. Lihat FAQ untuk informasi lebih lanjut." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Pieno supporto ai backup esportati da questa app, oltre a quelli generati da Tickmate, HabitBull o Rewire. Vedi le FAQ per maggiori informazioni." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "このアプリでエクスポートしたフルバックアップだけではなく、Tickmate、HabitBull、Rewire で生成したファイルも同様にサポートしています。詳細については FAQ を参照してください。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "მხარდაჭერილია ამ აპლიკაციით შექმნილი სარეზერვო ასლები, ასევე ფაილები, რომლებიც შექმნილია Tickmate-ით, HabitBull-ითა და Rewire-ით. მეტი ინფორმაციისათვის იხილე ხშირად დასმული კითხვები." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "Tickmate, HabitBull, Rewire에서 생성된 파일도 지원합니다. 더 자세한 설명은 FAQ에 있습니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "ഈ ആപ്പ് എക്‌സ്‌പോർട്ടുചെയ്‌ത മുഴുവൻ ബാക്കപ്പുകളും ടിക്ക്‌മേറ്റ്, ഹാബിറ്റ്‌ബുൾ അല്ലെങ്കിൽ റിവയർ സൃഷ്‌ടിച്ച ഫയലുകളും പിന്തുണയ്ക്കുന്നു.  കൂടുതൽ വിവരങ്ങൾക്ക് പതിവ് ചോദ്യങ്ങൾ കാണുക." } },
        "nb-NO" : { "stringUnit" : { "state" : "translated", "value" : "Støtter hele sikkerhetskopier eksportert av denne appen, i tillegg til filer generert av Tickmate, HabitBull, og Rewire. Sjekk ut FAQ for mer informasjon." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Ondersteunt volledige back-ups geëxporteerd door deze app, evenals bestanden die worden gegenereerd door Tickmate, HabitBull of Rewire. Zie de veel gestelde vragen voor meer informatie." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Wspiera pełne kopie zapasowe wyeksportowane przez tą aplikację zarówno jak i pliki wygenerowane przez Tickmate, Habitbull oraz Rewire. Zobacz FAQ po więcej informacji." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Aceita backups completos exportados por este app, além de arquivos gerados por Tickmate, HabitBull ou Rewire. Veja \"Ajuda\" para mais informações." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Suporta cópias de segurança completas exportadas por esta app, bem como ficheiros gerados pelo Tickmate, HabitBull ou Rewire. Veja as FAQ para mais informações." } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Acceptă backup-uri exportate de această aplicație precum și fișiere generate de Tickmate, HabitBull sau Rewire. Vezi „Întrebări frecvente” pentru mai multe informații." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Поддерживает полные резервные копии, экспортированные из этого приложения, а также файлы, сгенерированные приложениями Tickmate, HabitBull и Rewire. Подробнее смотрите в FAQ." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Podporuje úplné zálohy exportované touto aplikáciou, ako aj súbory generované aplikáciami Tickmate, HabitBull alebo Rewire. Viac informácií nájdete v častých otázkach (FAQ)." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Podpira polne varnostne kopije izvožene iz te aplikacije, kakor tudi datoteke, ki jih ustvari Tickmate, HabitBull ali Rewire. Glej Pogosta vprašanja za več informacij." } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Pored sopstvenog formata, program podržava i uvoz fajlova napravljenih u „Tickmate“, „HabitBull“ i „Rewire“. Detaljnije u ČPP." } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Поред сопственог формата, програм подржава и увоз фајлова направљених у „Tickmate“, „HabitBull“ и „Rewire“. Детаљније у ЧПП." } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Appen har stöd att importera data från denna app, men även backuper från Tickmate, Habitbull eller Rewire. Läs FAQ om du vill meta mer." } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "இந்த செயலி மூலம் ஆவண காப்பு நகல் முழுவதுமாக ஏற்றுமதி செய்யவும் மற்றும் Tickmate, HabitBull அல்லது Rewire செயலிகள் மூலம் உருவாக்கப்படும் ஆவணங்களும் இந்த செயலியில் பயண்படுத்தலாம் மேலும் தகவல்களுக்கு அதிகம் கேட்கப்படும் கேள்விகளை (FAQ) பார்க்கவும்." } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Loop tarafından oluşturulan yedeklemelerin yanı sıra Tickmate, HabitBull veya Rewire tarafından oluşturulan yedeklemeler da desteklenir. Detaylı bilgi için SSS bölümüne bak." } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Підтримує імпортування повної резервної копії, експортованої цією програмою, а також файлів, створених програмами Tickmate, HabitBull та Rewire. Більше інформації дивіться у ЧаПи." } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Hỗ trợ các bản sao lưu đầy đủ được xuất ra bởi ứng dụng, cũng như các file được tạo bởi Tickmate, HabitBull hoặc Rewire. Xem FAQ để biết thêm thông tin." } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "支持本应用导出的完整备份文件，也支持 Tickmate、HabitBull 或 Rewire 的导出文件，请参阅常见问题以获取更多信息。" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "可使用本程式所匯出的資料。\n另外也支援其他 App「Tickmate」、「HabitBull」或「Rewire」所產生的文件。\n請參閱「常見問題」來了解更多訊息。" } }
      }
    },
    "export_as_csv_summary" : {
      "localizations" : {
        "ar-SA" : { "stringUnit" : { "state" : "translated", "value" : "صدر ملف التي يمكن فتحها ببرنامج جداول البيانات مثل إكسل أو وبينوفيس. لا يمكن إستيراد هذا الملف.   " } },
        "bg-BG" : { "stringUnit" : { "state" : "translated", "value" : "Генерира файлове, които могат да се отварят със софтуер за електронни таблици като Microsoft Excel или OpenOffice Calc. Този файл не може да се импортира обратно." } },
        "ca-ES" : { "stringUnit" : { "state" : "translated", "value" : "Genera fitxers que poden ser oberts per programari de fulles de càlcul, com ara Microsoft Excel o OpenOffice Calc. Aquest fitxer no pot tornar-se a importar." } },
        "cs-CZ" : { "stringUnit" : { "state" : "translated", "value" : "Generuje soubory, které mohou být otevřeny v tabulkových editorech jako jsou Microsoft Excel nebo OpenOffice Calc. Tento soubor nelze importovat zpět." } },
        "da-DK" : { "stringUnit" : { "state" : "translated", "value" : "Opretter filer, der kan åbnes af regneark fra Microsoft Excel eller OpenOffice Calc. Denne fil kan ikke importeres tilbage." } },
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Erstellt Dateien, die von Tabellenkalkulationsprogrammen wie Microsoft Excel oder LibreOffice Calc geöffnet werden können. Diese Dateien können nicht wieder importiert werden." } },
        "el-GR" : { "stringUnit" : { "state" : "translated", "value" : "Παράγει αρχεία τα οποία μπορούν να ανοιχτούν από προγράμματα υπολογιστικών φύλλων όπως το Microsoft Edge ή το OpenOffice Calc. Δεν γίνεται επανεισαγωγή του αρχείου." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Generates files that can be opened by spreadsheet software such as Microsoft Excel or OpenOffice Calc. This file cannot be imported back." } },
        "eo-UY" : { "stringUnit" : { "state" : "translated", "value" : "Generas dosierojn, kiujn oni povas malfermi per kalkultabelaj programoj kiel Microsoft Excel aŭ OpenOffice Calc. Ĉi tiu dosiero ne povas esti importita reen." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Genera archivos que pueden ser abiertos por programas de hojas de cálculo como Microsoft Excel o OpenOffice Calc. Este archivo no puede volver a importarse de vuelta." } },
        "eu-ES" : { "stringUnit" : { "state" : "translated", "value" : "Microsoft Excel edo OpenOffice Calc bezalako kalkulu orrietarako softwareak ireki dezaketen fitxategiak sortzen ditu. Fitxategi hau ezin da berriz inportatu." } },
        "fa-IR" : { "stringUnit" : { "state" : "translated", "value" : "پرونده‌ای تولید می‌کند که می‌توان توسط برنامه‌های صفحه گسترده مانند Microsoft Excel و یا OpenOffice Calc بازشان کرد. این پرونده قابلیت وارد کردن مجدد به این برنامه را ندارد." } },
        "fi-FI" : { "stringUnit" : { "state" : "translated", "value" : "Luo tiedostoja jotka voidaan avata taulukkolaskentaohjelmistolla, kuten Microsoft Excel tai OpenOffice Calc. Tätä tiedostoa ei voi tuoda takaisin." } },
        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Génère des fichiers pouvant être ouverts par des tableurs comme Microsoft Excel ou LibreOffice Calc. Ce fichier ne peut pas être réimporté." } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "ליצירת קבצים שנפתחים בתוכנת גיליונות אלקטרוניים כמו Microsoft Exel או OpenOffice Calc. לא ניתן לייבא את הקובץ בחזרה." } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "\"ऐसी फाइल्स उत्पन्न करता है जो स्प्रेडशीट सॉफ़्टवरेस जैसे Microsoft Excel, OpenOffice Calc मे खुल सकती है.\n इस फ़ाइल में वापस आयात नहीं किया जा सकता है।\"" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Generira datoteke koje se mogu otvarati programima za tablice kao što su Microsoft Excel ili OpenOffice Calc. Ova datoteka se ne može uvoziti." } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Olyan fájlokat generál, amit táblázatkezelőkkel lehet megnyitni (pl. Microsoft Excel-lel vagy OpenOffice Calc-kal). Ezt a fájlt nem lehet visszaimportálni." } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Menghasilkan file yang bisa dibuka menggunakan aplikasi seperti Microsoft Excel atau OpenOffice Calc. File ini tidak bisa diimpor kembali." } },
        "it-IT" : { "stringUnit" : { "state" : "translated", "value" : "Genera un file che potrà essere aperto da programmi come Microsoft Excel o OpenOffice Calc. Non potrà essere importato." } },
        "ja-JP" : { "stringUnit" : { "state" : "translated", "value" : "Microsoft Excel や OpenOffice Calc などの表計算ソフトで開くことができるファイルを生成します。このファイルはインポートで戻すことはできません。" } },
        "ka-GE" : { "stringUnit" : { "state" : "translated", "value" : "ქმნის ფაილებს, რომელთა გახსნა შესაძლებელია ელექტრონული ცხრილის პროგრამებით, როგორებიცაა Microsoft Excel და OpenOffice Calc. ამ ფაილის უკან დაიმპორტირება შეუძლებელია." } },
        "ko-KR" : { "stringUnit" : { "state" : "translated", "value" : "Microsoft Excel나 OpenOffice Calc 같은 스프레드시트 소프트웨어로 열 수 있는 파일을 생성합니다. 이 파일은 다시 가져올 수 없습니다." } },
        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "മൈക്രോസോഫ്റ്റ് എക്സൽ അല്ലെങ്കിൽ ഓപ്പൺ ഓഫീസ് കാൽക്ക് പോലുള്ള സ്‌പ്രെഡ്‌ഷീറ്റ് സോഫ്‌റ്റ്‌വെയർ ഉപയോഗിച്ച് തുറക്കാൻ കഴിയുന്ന ഫയലുകൾ ജനറേറ്റുചെയ്യുന്നു.  ഈ ഫയൽ തിരികെ ഇറക്കുമതി ചെയ്യാൻ കഴിയില്ല." } },
        "nb-NO" : { "stringUnit" : { "state" : "translated", "value" : "Genererer filer som kan bli åpnet av regnearkprogrammer som Microsoft Excel og OpenOffice Calc. Disse filene kan ikke importeres tilbake." } },
        "nl-NL" : { "stringUnit" : { "state" : "translated", "value" : "Genereert bestanden die geopend kunnen worden door spreadsheet software zoals Microsoft Excel of OpenOffice Calc. Dit bestand kan niet opnieuw worden geïmporteerd." } },
        "pl-PL" : { "stringUnit" : { "state" : "translated", "value" : "Generuje pliki, które mogą być otwierane przez arkusze kalkulacyjne takie jak Microsoft Excel czy OpenOffice Calc. Taki plik nie może być importowany." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Gera arquivos que podem ser abertos em editores de planilha, como Microsoft Excel ou Openoffice Calc. Estes arquivos não podem ser importados de volta." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Gera ficheiros que podem ser abertos por programas de folhas de cálculo, como o Microsoft Excel ou o OpenOffice Calc. Este ficheiro não pode ser importado novamente para a app." } },
        "ro-RO" : { "stringUnit" : { "state" : "translated", "value" : "Generează fișiere ce pot fi deschise de software de foi de calcul precum Microsoft Office sau OpenOffice Calc. Acest fișier nu poate fi importat înapoi." } },
        "ru-RU" : { "stringUnit" : { "state" : "translated", "value" : "Генерирует файлы, которые можно открыть в ПО для работы с таблицами (таком как Microsoft Excel или OpenOffice Calc). Этот файл нельзя импортировать обратно." } },
        "sk-SK" : { "stringUnit" : { "state" : "translated", "value" : "Generuje súbory, ktoré je možné otvoriť pomocou tabuľkového softvéru, ako je Microsoft Excel alebo OpenOffice Calc. Tento súbor nie je možné importovať späť." } },
        "sl-SI" : { "stringUnit" : { "state" : "translated", "value" : "Generirane datoteke, ki se lahko odprejo s programsko opremo za preglednice, kot je Microsoft Excel ali OpenOffice Calc. Te datoteke ni mogoče uvoziti nazaj." } },
        "sr-CS" : { "stringUnit" : { "state" : "translated", "value" : "Pravi fajl koji možete otvoriti u programu za rad sa tabelama (npr. Microsoft Excel ili OpenOffice Calc). Ne može se uvesti nazad u aplikaciju." } },
        "sr-SP" : { "stringUnit" : { "state" : "translated", "value" : "Прави фајл који можете отворити у програму за рад са табелама (нпр. Мајкрософт Ексел или Опенофис Калк). Не може се увести назад у апликацију." } },
        "sv-SE" : { "stringUnit" : { "state" : "translated", "value" : "Filerna genererade kan öppnas i Microsoft Excel eller OpenOffice Calc. Däremot kan denna fil inte importeras tillbaka till appen." } },
        "ta-IN" : { "stringUnit" : { "state" : "translated", "value" : "உருவாக்கப்பட்ட ஆவணங்களை விரித்தாள் மென்பொருள்களான Microsoft Excel அல்லது OpenOffice Calc மூலம் திறக்கலாம். ஆனால் இவற்றை திரும்ப இறக்குமதி செய்ய முடியாது." } },
        "tr-TR" : { "stringUnit" : { "state" : "translated", "value" : "Microsoft Excel veya OpenOffice Calc. tarafından açılabilen bir dosya oluşturur. Bu dosya tekrar içeri aktarılamaz." } },
        "uk-UA" : { "stringUnit" : { "state" : "translated", "value" : "Створює файли, які можна відкрити у програмах для роботи з таблицями (як-от: Microsoft Excel або OpenOffice Calc). Цей файл не можна імпортувати назад." } },
        "vi-VN" : { "stringUnit" : { "state" : "translated", "value" : "Tạo ra các tệp có thể được mở bằng các phần mềm bảng tính như Microsoft Excel hoặc OpenOffice Calc. Tệp này không thể được nhập lại." } },
        "zh-CN" : { "stringUnit" : { "state" : "translated", "value" : "生成可以通过电子表格软件打开的文件，如 Microsoft Excel 或 OpenOffice Calc。该文件无法重新导入。" } },
        "zh-TW" : { "stringUnit" : { "state" : "translated", "value" : "產生可以利用表格軟體打開的文件，如「Microsoft Excel」或「OpenOffice Calc」。\n此文件無法重新輸入本程式。" } }
