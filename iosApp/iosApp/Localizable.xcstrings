        "ml-IN" : { "stringUnit" : { "state" : "translated", "value" : "അമർത്തിപ്പിടിക്കുക എന്നതിനുപകരം ഒരൊറ്റ ടാപ്പിലൂടെ ചെക്ക്മാർക്കുകൾ ഇടുക." } },
