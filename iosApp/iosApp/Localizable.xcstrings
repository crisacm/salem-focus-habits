        "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Aucun dossier sélectionné" } },
        "gu-IN" : { "stringUnit" : { "state" : "translated", "value" : "કોઈ ફોલ્ડર પસંદ કરાયેલ નથી" } },
        "he-IL" : { "stringUnit" : { "state" : "translated", "value" : "לא נבחרה תיקיה" } },
        "hi-IN" : { "stringUnit" : { "state" : "translated", "value" : "कोई फ़ोल्डर चयनित नहीं है" } },
        "hr-HR" : { "stringUnit" : { "state" : "translated", "value" : "Nije odabrana nijedna mapa" } },
        "hu-HU" : { "stringUnit" : { "state" : "translated", "value" : "Nincs mappa kiválasztva" } },
        "hy-AM" : { "stringUnit" : { "state" : "translated", "value" : "Թղթապանակ չի ընտրվել" } },
        "id-ID" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada folder yang dipilih" } },
        "is-IS" : { "stringUnit" : { "state" : "translated", "value" : "Engin mappa valin" } },
